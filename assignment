<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz Application</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .quiz-container {
            background: #fff;
            padding: 25px;
            border-radius: 10px;
            width: 400px;
            text-align: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        }

        h2 {
            margin-bottom: 20px;
        }

        .option {
            display: block;
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border: none;
            background: #007bff;
            color: white;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            transition: 0.3s;
        }

        .option:hover {
            background: #0056b3;
        }

        #result {
            margin-top: 20px;
            font-size: 20px;
            font-weight: bold;
        }

        .correct {
            color: green;
        }

        .incorrect {
            color: red;
        }
    </style>
</head>
<body>

<div class="quiz-container">
    <h2>Quiz Application</h2>

    <p><strong>Question:</strong> What does HTML stand for?</p>

    <button class="option" onclick="checkAnswer(false)">
        Hyper Transfer Markup Language
    </button>

    <button class="option" onclick="checkAnswer(true)">
        Hyper Text Markup Language
    </button>

    <button class="option" onclick="checkAnswer(false)">
        High Text Machine Language
    </button>

    <button class="option" onclick="checkAnswer(false)">
        Hyper Tool Multi Language
    </button>

    <p id="result"></p>
</div>

<script>
function checkAnswer(isCorrect) {
    const result = document.getElementById("result");

    if (isCorrect) {
        result.textContent =  "Correct Answer!";
        result.className = "correct";
    } else {
        result.textContent = "Incorrect Answer!";
        result.className = "incorrect";
    }
}
</script>

</body>
</html>